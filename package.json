{
    "name": "datera",
    "version": "0.2.1",
    "description": "Limpa, unifica e organiza dados bagunçados de bancos de dados, planilhas, CSV, JSON, XML e Parquet, e grava em bancos de dados, Google Sheets, Excel, CSV, JSON, XML ou Parquet.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "datera": "dist/main.js"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepublishOnly": "npm run build && npm test",
        "release:prepare": "tsx scripts/prepareRelease.ts",
        "start": "tsx src/main.ts",
        "validate": "tsx src/main.ts validate",
        "example": "tsx src/main.ts --config examples/config.csv.json",
        "example:excel": "tsx src/main.ts --config examples/config.excel.json",
        "example:xml": "tsx src/main.ts --config examples/config.xml.json",
        "desktop": "npm run dev -w apps/desktop",
        "desktop:dev": "npm run dev -w apps/dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "typecheck:telas": "tsc -p e2e",
        "test:telas": "playwright test",
        "test:telas:ver": "playwright test --headed --project=claro --workers=1",
        "test:sheet": "tsx scripts/testSheetFake.ts",
        "prepare": "husky"
    },
    "keywords": [
        "etl",
        "csv",
        "excel",
        "xml",
        "parquet",
        "sqlite",
        "sqlserver",
        "postgres",
        "mysql",
        "dedupe",
        "merge",
        "data-cleaning",
        "google-sheets"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alessandravieiradev-blip/datera.git"
    },
    "homepage": "https://github.com/alessandravieiradev-blip/datera#readme",
    "bugs": "https://github.com/alessandravieiradev-blip/datera/issues",
    "engines": {
        "node": ">=22.13"
    },
    "author": "Alessandra Vieira",
    "license": "MIT",
    "type": "commonjs",
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@googleapis/sheets": "^18.0.1",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.3",
        "exceljs": "^4.4.0",
        "husky": "^9.1.7",
        "hyparquet": "^1.31.2",
        "hyparquet-compressors": "^1.1.2",
        "hyparquet-writer": "^0.16.10",
        "lint-staged": "^17.5.1",
        "mssql": "^12.7.2",
        "mysql2": "^3.24.4",
        "pg": "^8.23.0",
        "prettier": "^3.9.9",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "zod": "^4.6.5"
    },
    "peerDependencies": {
        "@googleapis/sheets": "^18.0.1",
        "exceljs": "^4.4.0",
        "hyparquet": "^1.31.2",
        "hyparquet-compressors": "^1.1.2",
        "hyparquet-writer": "^0.16.10",
        "mssql": "^12.7.2",
        "mysql2": "^3.24.4",
        "pg": "^8.23.0"
    },
    "peerDependenciesMeta": {
        "@googleapis/sheets": {
            "optional": true
        },
        "exceljs": {
            "optional": true
        },
        "hyparquet": {
            "optional": true
        },
        "hyparquet-compressors": {
            "optional": true
        },
        "hyparquet-writer": {
            "optional": true
        },
        "mssql": {
            "optional": true
        },
        "mysql2": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "lint-staged": {
        "**/*.{ts,tsx,json,md}": [
            "prettier --write"
        ]
    },
    "overrides": {
        "uuid": "^11.1.1"
    }
}
