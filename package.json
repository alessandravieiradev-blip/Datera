{
    "name": "datera",
    "version": "1.0.0",
    "description": "Limpa, unifica e organiza dados bagunçados de bancos de dados, planilhas, CSV, JSON, XML e Parquet, e exporta pro Google Sheets, Excel, CSV, JSON, XML ou Parquet.",
    "main": "index.js",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "start": "tsx src/main.ts",
        "validate": "tsx src/main.ts validate",
        "example": "tsx src/main.ts --config examples/config.csv.json",
        "example:excel": "tsx src/main.ts --config examples/config.excel.json",
        "example:xml": "tsx src/main.ts --config examples/config.xml.json",
        "desktop": "npm run dev -w apps/desktop",
        "desktop:dev": "npm run dev -w apps/dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "test:connection": "tsx scripts/testConnection.ts",
        "test:config": "tsx scripts/testConfig.ts",
        "test:sheet": "tsx scripts/testSheetFake.ts",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "commonjs",
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@types/node": "^22.20.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.9",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@googleapis/sheets": "^18.0.1",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "exceljs": "^4.4.0",
        "hyparquet": "^1.31.2",
        "hyparquet-compressors": "^1.1.2",
        "hyparquet-writer": "^0.16.10",
        "mssql": "^12.7.2",
        "mysql2": "^3.24.4",
        "pg": "^8.23.0",
        "zod": "^4.6.5"
    },
    "lint-staged": {
        "**/*.{ts,tsx,json,md}": [
            "prettier --write"
        ]
    },
    "overrides": {
        "uuid": "^11.1.1"
    }
}
